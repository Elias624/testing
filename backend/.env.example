PORT=3000
NODE_ENV=development

# Frontend origin served by VS Code Live Server
FRONTEND_ORIGIN=http://127.0.0.1:5500

# MySQL connection: replace with your team's actual database settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=cineit

# Generate a long random secret; never commit the real .env file
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters